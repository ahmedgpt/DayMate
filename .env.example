APP_ENV=development

# --- MCP server / REST API (shared by the agent and n8n) ---
MCP_HOST=127.0.0.1
MCP_PORT=8000
# Agent connects here:
MCP_URL=http://127.0.0.1:8000/mcp
# Shared secret for the agent and n8n. Generate a long random string.
MCP_AUTH_TOKEN=

DATABASE_PATH=./data/daymate.db

# --- LLM (Groq, free tier; key from console.groq.com/keys) ---
GROQ_API_KEY=
# Must support tool calling. Run scripts/check_groq.py to see what your account can use.
LLM_MODEL=openai/gpt-oss-120b

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Weather (Open-Meteo, no key needed) ---
# Used only when the user does not name a location. Leave empty to always ask.
DEFAULT_LOCATION=

# --- Reminder delivery ---
REMINDER_LEASE_SECONDS=300
REMINDER_MAX_ATTEMPTS=5
